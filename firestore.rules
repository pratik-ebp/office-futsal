rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read/write for everyone with the site URL. This app has no
    // server-side auth — the "Admin login" button is a client-side UI
    // gate only (see .env.example), not enforced here. Anyone who opens
    // devtools can write to Firestore directly regardless of these
    // rules being this permissive. Acceptable for a casual internal
    // office poll; do not reuse this file for anything holding
    // sensitive data.
    match /players/{playerId} {
      allow read, write: if true;
    }
    match /responses/{cycleId} {
      allow read, write: if true;
    }
    match /paid/{cycleId} {
      allow read, write: if true;
    }
    // Player codes live separately from /players so they're never part of
    // the normal roster payload every visitor downloads on page load. `get`
    // (fetch one known doc id) is allowed so the app can check a single
    // code when someone verifies a move; `list` (dump/query the whole
    // collection) is denied so codes can't be bulk-scraped in one call.
    // Doc IDs are player-name slugs, which are public, so a determined
    // person could still guess-and-fetch codes one at a time from devtools
    // — real enforcement needs server-side code, which this app doesn't
    // have. See firestore.rules header above.
    match /playerCodes/{playerId} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }
    // Weekly cost breakdown (receipt image + total + player count), keyed by
    // cycle id like responses/paid. Image is stored as a compressed
    // base64 data URL directly on the doc (no Firebase Storage) to keep
    // this on the free Spark plan.
    match /costs/{cycleId} {
      allow read, write: if true;
    }
    // Booking status for the week (counting / booked / cancelled), keyed by
    // cycle id like responses/paid/costs.
    match /matchStatus/{cycleId} {
      allow read, write: if true;
    }
    // Admin-entered day/date label for the header ("Who's in for
    // <day>, <date>?"), keyed by cycle id like responses/paid/costs.
    match /matchInfo/{cycleId} {
      allow read, write: if true;
    }
    // Snapshot of the roster (id + name) taken at the moment of the most
    // recent admin reset, so the "Last played" tab keeps showing the right
    // names even if a player is later renamed or removed from /players.
    match /lastPlayedRoster/{cycleId} {
      allow read, write: if true;
    }
  }
}
