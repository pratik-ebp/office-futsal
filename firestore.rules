rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = the single Firebase Auth account below. Enforced server-side,
    // so editing client state in devtools gives no write access.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'admin@officefutsal.com';
    }

    // Roster: anyone reads. Players may only touch lastMovedAt.
    // Create, delete and rename/flag are admin only.
    match /players/{playerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMovedAt']);
    }

    // Open: players use these through the code-gated UI without logging in.
    match /responses/{cycleId} { allow read, write: if true; }
    match /paid/{cycleId}      { allow read, write: if true; }
    match /movements/{cycleId} { allow read, write: if true; }

    // Players can clear their own nudge. Only admin deletes the doc.
    match /nudges/{cycleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Single get stays open for code verification. List is blocked.
    // Only admin writes.
    match /playerCodes/{playerId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Everyone reads. Only admin writes.
    match /costs/{cycleId}            { allow read: if true; allow write: if isAdmin(); }
    match /matchStatus/{cycleId}      { allow read: if true; allow write: if isAdmin(); }
    match /matchInfo/{cycleId}        { allow read: if true; allow write: if isAdmin(); }
    match /lastPlayedRoster/{cycleId} { allow read: if true; allow write: if isAdmin(); }
    match /removedPlayers/{playerId}  { allow read: if true; allow write: if isAdmin(); }
    match /attendanceTally/{docId}    { allow read: if true; allow write: if isAdmin(); }
  }
}
