# Copy to .env.local (gitignored) and fill in real values.

# Firebase project config — from Firebase Console > Project settings >
# General > Your apps > SDK setup and configuration ("Config" option).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gates Add/Remove player controls — client-side only, not real security
# (visible in devtools/bundle to anyone who looks). Good enough to stop
# casual edits from teammates, not to protect sensitive data.
VITE_ADMIN_PASSWORD=changeme
