# Copy to .env.local (gitignored) and fill in real values.

# Firebase project config — from Firebase Console > Project settings >
# General > Your apps > SDK setup and configuration ("Config" option).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gates Add/Remove player controls — client-side only, not real security
# (Firestore writes stay open regardless — see firestore.rules). Storing
# the SHA-256 hash instead of the plaintext just stops the password being
# trivially readable in the bundle. Compute with:
#   node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
VITE_ADMIN_PASSWORD_HASH=
